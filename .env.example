# OrderVista environment template
# Copy this file to `.env` (never commit the real file) and fill in the values.
# The Flutter app consumes these via `--dart-define-from-file=.env`.

# Supabase project configuration
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="supabase-service-role-key"
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_API_KEY=""
ORDERVISTA_COMPANY_ID="00000000-0000-0000-0000-000000000001"
ORDERVISTA_DRIVER_ID="00000000-0000-0000-0000-0000000000dd"

# External integrations
MAPBOX_ACCESS_TOKEN="pk.your-mapbox-token"
MAPBOX_SECRET_ACCESS_TOKEN=""
OPENAI_API_KEY="sk-your-openai-api-key"
ORDERVISTA_API_BASE_URL="http://localhost:3000"
ORDERVISTA_TELEMETRY_ENDPOINT="https://telemetry.example.com/ingest"
ORDERVISTA_DISPATCH_PORTAL_URL="https://dispatch.example.com"

# App behavior
ORDERVISTA_ENV="development"
ORDERVISTA_LOG_LEVEL="info"
